. * Step 2. Check required user-written Stata commands.
. capture program drop ensure_network_commands

. program define ensure_network_commands
  1.     capture which network
  2.     local has_network = (_rc == 0)
  3. 
.     capture which networkplot
  4.     local has_networkplot = (_rc == 0)
  5. 
.     capture which netfunnel
  6.     local has_netfunnel = (_rc == 0)
  7. 
.     if (`has_network' & `has_networkplot' & `has_netfunnel') {
  8.         global APPENDIX_HAS_NETWORKPLOT 1
  9.         global APPENDIX_HAS_NETFUNNEL 1
 10.         exit
 11.     }
 12. 
.     di as txt "Installing required Stata network meta-analysis commands
>  if needed ..."
 13. 
.     if (!`has_network') {
 14.         capture noisily net install network, from("https://raw.githu
> busercontent.com/UCL/network/master/package/") replace
 15.         capture which network
 16.         local has_network = (_rc == 0)
 17.     }
 18. 
.     if (!`has_network') {
 19.         capture noisily ssc install network, replace
 20.         capture which network
 21.         local has_network = (_rc == 0)
 22.     }
 23. 
.     if (!`has_network') {
 24.         capture noisily net install st0410_1, from("https://www.stat
> a-journal.com/software/sj15-4") replace
 25.         capture which network
 26.         local has_network = (_rc == 0)
 27.     }
 28. 
.     if (!`has_networkplot' | !`has_netfunnel') {
 29.         capture noisily net install network_graphs, from("https://ww
> w.cer-methods.com/Stata") replace
 30.         capture which networkplot
 31.         local has_networkplot = (_rc == 0)
 32.         capture which netfunnel
 33.         local has_netfunnel = (_rc == 0)
 34.     }
 35. 
.     if (!`has_networkplot' | !`has_netfunnel') {
 36.         capture which github
 37.         if (_rc) {
 38.             capture noisily net install github, from("https://haghis
> h.github.io/github/") replace
 39.         }
 40. 
.         capture which github
 41.         if (_rc == 0) {
 42.             capture noisily github install achaimani/network_graphs
 43.             capture program drop networkplot
 44.             capture program drop netfunnel
 45. 
.             capture which networkplot
 46.             local has_networkplot = (_rc == 0)
 47.             capture which netfunnel
 48.             local has_netfunnel = (_rc == 0)
 49.         }
 50.     }
 51. 
.     global APPENDIX_HAS_NETWORKPLOT `has_networkplot'
 52.     global APPENDIX_HAS_NETFUNNEL `has_netfunnel'
 53. 
.     if (!`has_network') {
 54.         di as error "Required command 'network' is still unavailable
> ."
 55.         di as error "Run one of these commands inside Stata, then re
> run this do-file:"
 56.         di as error "    net install network, from(https://raw.githu
> busercontent.com/UCL/network/master/package/) replace"
 57.         di as error "    ssc install network, replace"
 58.         di as error "    net install st0410_1, from(https://www.stat
> a-journal.com/software/sj15-4) replace"
 59.         exit 199
 60.     }
 61. 
.     if (!`has_networkplot') {
 62.         di as txt "networkplot is unavailable; network map export wi
> ll be skipped."
 63.     }
 64. 
.     if (!`has_netfunnel') {
 65.         di as txt "netfunnel is unavailable; funnel plot export will
>  be skipped."
 66.     }
 67. end

. 
. 
. * Step 3. Define a shared schema check.
. capture program drop assert_columns

. program define assert_columns
  1.     syntax varlist
  2. 
.     foreach var of local varlist {
  3.         capture confirm variable `var'
  4.         if (_rc) {
  5.             di as error "Required column `var' not found."
  6.             exit 111
  7.         }
  8.     }
  9. end

. 
. 
. * Step 4. Save graphs in editable and image formats.
. capture program drop save_graph_outputs

. program define save_graph_outputs
  1.     syntax, BASENAME(string) [WIDTH(integer 2400) HEIGHT(integer 0)]
  2. 
.     graph save "`basename'.gph", replace
  3. 
.     if (`height' > 0) {
  4.         graph export "`basename'.png", replace width(`width') height
> (`height')
  5.     }
  6.     else {
  7.         graph export "`basename'.png", replace width(`width')
  8.     }
  9. end

. 
. 
. * Step 5. Build a project-local netfunnel override with a bottom multi-
> column legend.
. capture program drop ensure_local_netfunnel

. program define ensure_local_netfunnel
  1.     syntax, PROJECTDIR(string)
  2. 
.     if ("$APPENDIX_HAS_NETFUNNEL" != "1") {
  3.         exit
  4.     }
  5. 
.     local override_dir "`projectdir'\ado_override"
  6.     local override_file "`override_dir'\netfunnel.ado"
  7. 
.     capture mkdir "`override_dir'"
  8. 
.     capture findfile netfunnel.ado
  9.     if (_rc) {
 10.         di as txt "Skipping the project-local netfunnel override bec
> ause netfunnel.ado was not found."
 11.         exit
 12.     }
 13. 
.     local source_file "`r(fn)'"
 14. 
.     capture noisily filefilter "`source_file'" "`override_file'", ///
>         from("col(6)") ///
>         to("position(6) ring(1) col(3) colfirst size(vsmall)") ///
>         replace
 15. 
.     if (_rc) {
 16.         di as txt "Using the installed netfunnel because the local l
> egend patch could not be created."
 17.         exit
 18.     }
 19. 
.     if (r(occurrences) == 0) {
 20.         di as txt "Using the installed netfunnel because the expecte
> d legend marker was not found in the source file."
 21.         exit
 22.     }
 23. 
.     adopath ++ "`override_dir'"
 24.     capture program drop netfunnel
 25. end

. 
. 
. * Step 6. Resize funnel graphs for wider export.
. capture program drop format_funnel_graph

. program define format_funnel_graph
  1.     capture noisily graph display, xsize(10) ysize(7)
  2. 
.     if (_rc) {
  3.         di as txt "Keeping the default funnel graph size because gra
> ph display failed in this Stata setup."
  4.     }
  5. end

. 
. 
. * Step 7. Build network and funnel plots for continuous outcomes.
. capture program drop run_continuous_network

. program define run_continuous_network
  1.     syntax, DATAfile(string) OUTcome(string)
  2. 
.     import delimited "`datafile'", clear
  3.     assert_columns study treatment mean stddev samplesize
  4. 
.     replace treatment = lower(trim(treatment))
  5.     isid study treatment
  6. 
.     network setup mean stddev samplesize, ///
>         studyvar(study) ///
>         trtvar(treatment) ///
>         format(augment) ///
>         nocodes
  7. 
.     if ("$APPENDIX_HAS_NETWORKPLOT" == "1") {
  8.         capture noisily network map, improve
  9.         if (_rc == 0) {
 10.             save_graph_outputs, basename("figures\network_`outcome'"
> )
 11.         }
 12.         else {
 13.             di as txt "Skipping network map for `outcome' because ne
> twork map failed in this Stata setup."
 14.         }
 15.     }
 16.     else {
 17.         di as txt "Skipping network map for `outcome' because networ
> kplot is unavailable."
 18.     }
 19. 
.     if ("$APPENDIX_HAS_NETFUNNEL" == "1") {
 20.         network convert pairs
 21. 
.         netfunnel _y _stderr _t1 _t2, ///
>             bycomparison ///
>             ytitle("Standard error of mean difference")
 22. 
.         format_funnel_graph
 23.         save_graph_outputs, basename("figures\funnel_`outcome'") wid
> th(3200) height(2240)
 24.     }
 25.     else {
 26.         di as txt "Skipping funnel plot for `outcome' because netfun
> nel is unavailable."
 27.     }
 28. end

. 
. 
. * Step 8. Build network and funnel plots for binary outcomes.
. capture program drop run_binary_network

. program define run_binary_network
  1.     syntax, DATAfile(string) OUTcome(string)
  2. 
.     import delimited "`datafile'", clear
  3.     assert_columns study treatment responders samplesize
  4. 
.     replace treatment = lower(trim(treatment))
  5.     assert responders >= 0
  6.     assert responders <= samplesize
  7.     isid study treatment
  8. 
.     network setup responders samplesize, ///
>         studyvar(study) ///
>         trtvar(treatment) ///
>         format(augment) ///
>         nocodes
  9. 
.     if ("$APPENDIX_HAS_NETWORKPLOT" == "1") {
 10.         capture noisily network map, improve
 11.         if (_rc == 0) {
 12.             save_graph_outputs, basename("figures\network_`outcome'"
> )
 13.         }
 14.         else {
 15.             di as txt "Skipping network map for `outcome' because ne
> twork map failed in this Stata setup."
 16.         }
 17.     }
 18.     else {
 19.         di as txt "Skipping network map for `outcome' because networ
> kplot is unavailable."
 20.     }
 21. 
.     if ("$APPENDIX_HAS_NETFUNNEL" == "1") {
 22.         network convert pairs
 23. 
.         netfunnel _y _stderr _t1 _t2, ///
>             bycomparison ///
>             ytitle("Standard error of log odds ratio")
 24. 
.         format_funnel_graph
 25.         save_graph_outputs, basename("figures\funnel_`outcome'") wid
> th(3200) height(2240)
 26.     }
 27.     else {
 28.         di as txt "Skipping funnel plot for `outcome' because netfun
> nel is unavailable."
 29.     }
 30. end

. 
